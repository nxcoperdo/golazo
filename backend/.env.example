# Copia a .env y rellena. NO subas .env al repositorio.

# Contraseña de PostgreSQL (docker compose la usa para db y api)
POSTGRES_PASSWORD=cambia-esto

# Firma de los JWT. Genera uno largo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto

# ID de cliente OAuth (tipo "Web") de Google, para validar el login con Google. Vacío = Google desactivado.
GOOGLE_CLIENT_ID=

# Solo en el servidor: dominio (apuntando a la IP del VPS) para el HTTPS automático. Ej.: golazo.duckdns.org
# DOMAIN=golazo.duckdns.org

# Puerto local del API en el servidor (solo 127.0.0.1) si el 3000 ya está en uso por otra app.
# API_HOST_PORT=3010

# Solo para desarrollo fuera de Docker:
# DATABASE_URL=postgres://golazo:cambia-esto@localhost:5432/golazo
# PORT=3000

# --- Opcionales ---
# Correo (recuperar contraseña y avisos de pago). Sin esto, los correos solo salen en el log del servidor.
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
# MAIL_FROM=Golazo <no-reply@tudominio.com>
# Enlace que recibe el usuario para restablecer su contraseña (debe abrir la app).
# APP_RESET_URL=golazo://reset-password
# Mensualidad de las canchas en COP y minutos para liberar reservas sin comprobante.
# SUBSCRIPTION_PRICE=100000
# UNPAID_MINUTES=30
# Push FCM: ruta DENTRO del contenedor al JSON de la cuenta de servicio (móntalo como volumen).
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json
# DISABLE_JOBS=1   # solo para pruebas: desactiva las tareas periódicas
# Cuentas donde los dueños pagan la mensualidad (JSON en una línea, entre comillas simples).
# PLATFORM_PAYMENT_ACCOUNTS='[{"label":"Nequi","account":"300 000 0000","holder":"Golazo S.A.S."}]'
# Exigir correo confirmado para reservar y publicar canchas. Activar SOLO cuando SMTP_URL funcione.
# REQUIRE_EMAIL_VERIFICATION=1
# APP_VERIFY_URL=golazo://verify-email

# Responsable del tratamiento de datos (salen en https://TU-DOMINIO/legal/terminos, /privacidad, /soporte).
# LEGAL_RESPONSIBLE_NAME=Nombre Apellido
# LEGAL_RESPONSIBLE_ID=C.C. 123456789
# LEGAL_CONTACT_EMAIL=soporte@tudominio.com
# LEGAL_PHONE=300 000 0000
# LEGAL_ADDRESS=Calle 1 # 2-3
# LEGAL_CITY=Bogotá
