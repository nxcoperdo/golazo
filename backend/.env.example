# Copia a .env y rellena. NO subas .env al repositorio.

# Contraseña de PostgreSQL (docker compose la usa para db y api)
POSTGRES_PASSWORD=cambia-esto

# Firma de los JWT. Genera uno largo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto

# ID de cliente OAuth (tipo "Web") de Google, para validar el login con Google. Vacío = Google desactivado.
GOOGLE_CLIENT_ID=

# Solo para desarrollo fuera de Docker:
# DATABASE_URL=postgres://golazo:cambia-esto@localhost:5432/golazo
# PORT=3000
