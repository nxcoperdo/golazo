        <div className="mt-4 flex items-center gap-3 rounded-2xl border border-[#e4cd82] bg-[#fff6d9] px-4 py-3 text-[#725815]">
          <span className="grid size-8 shrink-0 place-items-center rounded-full bg-[#f6df91] text-sm font-extrabold"><Icon name="clock" size={17} /></span>
