      {locationStatus === "error" && (
        <div className="fixed bottom-24 left-1/2 z-50 flex w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 items-center justify-between gap-4 rounded-2xl bg-[#11251b] px-4 py-3.5 text-white shadow-2xl">
