          <button aria-label="Volver" className="grid size-11 place-items-center rounded-full border border-[#143e2a]/10 bg-white text-[#174e32]" onClick={onBack}>
            <span className="rotate-180"><Icon name="chevron" /></span>
          </button>
          <div className="flex flex-1 flex-col items-center justify-center pb-14 text-center">
            <span className="grid size-24 place-items-center rounded-full bg-[#d9ff5b] text-4xl font-black text-[#174e32]">✓</span>
            <p className="mt-8 text-xs font-bold uppercase tracking-[0.13em] text-[#438158]">Pago en revisión</p>
            <h1 className="mt-2 text-3xl font-extrabold tracking-[-0.045em]">Comprobante enviado</h1>
            <p className="mt-3 max-w-xs text-sm leading-relaxed text-[#68776e]">El dueño revisará tu comprobante. Te avisaremos cuando la reserva quede confirmada.</p>
            <div className="mt-7 w-full rounded-[22px] border border-[#143e2a]/10 bg-white p-5 text-left">
              <p className="text-sm font-extrabold">{booking.court.name}</p>
              <p className="mt-1 text-xs font-semibold text-[#78877e]">{booking.dateLabel} · {booking.timeLabel}</p>
              <div className="mt-4 flex items-center justify-between border-t border-[#143e2a]/8 pt-4">
                <span className="text-xs font-semibold text-[#78877e]">Anticipo enviado</span>
                <strong className="text-lg">${booking.advance.toLocaleString("es-CO")}</strong>
              </div>
            </div>
            <button className="mt-7 w-full rounded-2xl bg-[#174e32] py-4 text-sm font-extrabold text-white" onClick={onReservations}>Ver mis reservas</button>
          </div>
        </div>
      </main>
    );
  }

  return (
    <div className="min-h-screen bg-[#f4f5ec] pb-32 text-[#11251b]">
      <header className="sticky top-0 z-30 border-b border-[#143e2a]/10 bg-[#f4f5ec]/95 backdrop-blur-xl">
        <div className="mx-auto flex max-w-md items-center gap-4 px-5 pb-4 pt-[max(16px,env(safe-area-inset-top))]">
          <button aria-label="Volver al detalle" className="grid size-10 place-items-center rounded-full border border-[#143e2a]/10 bg-white text-[#174e32]" onClick={onBack}>
            <span className="rotate-180"><Icon name="chevron" /></span>
          </button>
          <div>
            <p className="text-xs font-bold text-[#438158]">Paso final</p>
            <h1 className="text-lg font-extrabold tracking-[-0.03em]">Pagar anticipo</h1>
          </div>
        </div>
      </header>

      <main className="mx-auto max-w-md px-5 py-6">
        <div className="rounded-[22px] bg-[#174e32] p-5 text-white shadow-[0_16px_36px_rgba(23,78,50,.18)]">
          <div className="flex justify-between gap-4">
            <div>
              <p className="text-xs font-semibold text-white/60">Total de la reserva</p>
              <p className="mt-1 text-xl font-extrabold">${booking.total.toLocaleString("es-CO")}</p>
            </div>
            <div className="text-right">
              <p className="text-xs font-semibold text-white/60">Anticipo a pagar</p>
              <p className="mt-1 text-2xl font-extrabold text-[#d9ff5b]">${booking.advance.toLocaleString("es-CO")}</p>
            </div>
          </div>
          <div className="mt-5 border-t border-white/15 pt-4">
            <p className="text-sm font-bold">{booking.court.name}</p>
