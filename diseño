                    className={`absolute right-4 top-4 grid size-10 place-items-center rounded-full backdrop-blur-md transition ${
                      favorites.includes(court.id) ? "bg-[#d9ff5b] text-[#174e32]" : "bg-white/90 text-[#174e32]"
                    }`}
                    onClick={(event) => {
                      event.stopPropagation();
                      toggleFavorite(court.id);
                    }}
                  >
                    <Icon name="heart" filled={favorites.includes(court.id)} />
                  </button>
                  <span className="absolute bottom-4 left-4 flex items-center gap-1.5 rounded-full bg-[#071b10]/75 px-3 py-1.5 text-xs font-bold text-white backdrop-blur-md">
                    <Icon name="location" size={14} />
                    {court.distance}
                  </span>
                </div>

                <div className="p-5">
                  <div className="flex items-start justify-between gap-4">
                    <div>
                      <h3 className="text-lg font-extrabold tracking-[-0.025em]">{court.name}</h3>
                      <p className="mt-1 text-sm font-medium text-[#6c7b72]">{court.area} · {court.city}</p>
                      {court.deposit > 0 && (
                        <p className="mt-2 inline-flex rounded-full bg-[#edf3e9] px-2.5 py-1 text-[10px] font-extrabold text-[#285e3c]">
                          Anticipo {court.deposit} %
