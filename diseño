          </div>

          <div className="flex items-center justify-between px-5 pt-3 lg:px-8">
            <p className="text-sm font-extrabold">{filteredCourts.length} {filteredCourts.length === 1 ? "cancha disponible" : "canchas disponibles"}</p>
            <button className="flex items-center gap-1.5 text-xs font-bold text-[#438158] sm:hidden"><Icon name="map" size={16} />Mapa</button>
          </div>

          <div className="mt-5 grid gap-5 px-5 md:grid-cols-2 lg:px-8 xl:grid-cols-3">
            {filteredCourts.map((court, index) => (
              <article
                className={`group cursor-pointer overflow-hidden rounded-[24px] border border-[#143e2a]/10 bg-white shadow-[0_12px_36px_rgba(19,53,36,.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(19,53,36,.14)] ${
                  index === 0 ? "md:col-span-2 xl:col-span-1" : ""
                }`}
                key={court.id}
                onClick={() => onOpenCourt(court)}
              >
                <div className="relative h-52 overflow-hidden">
                  <img
                    alt={`Cancha sintética ${court.name}`}
                    className="h-full w-full object-cover transition duration-500 group-hover:scale-105"
