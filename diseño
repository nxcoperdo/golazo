          </button>

          <nav className="hidden items-center gap-8 text-sm font-bold md:flex" aria-label="Navegación principal">
            <button className="text-[#174e32]">Explorar</button>
            <button className="text-[#5c6d63] transition hover:text-[#174e32]">Mis reservas</button>
            <button className="text-[#5c6d63] transition hover:text-[#174e32]">Favoritos</button>
          </nav>

          <button className="grid size-10 place-items-center rounded-full border border-[#143e2a]/15 bg-white text-[#174e32]" aria-label="Abrir perfil">
            <Icon name="user" />
          </button>
        </div>
      </header>

      <main>
        <section className="mx-auto max-w-7xl pb-28 pt-6 lg:pb-16 lg:pt-10">
          <div className="px-5 lg:px-8">
            <p className="text-sm font-bold text-[#438158]">Juega donde quieras</p>
            <div className="mt-1 flex items-end justify-between">
              <h2 className="text-2xl font-extrabold tracking-[-0.04em] sm:text-3xl">Encuentra tu cancha</h2>
              <button className="hidden items-center gap-2 text-sm font-bold text-[#174e32] sm:flex">
                <Icon name="map" />
                Ver mapa
              </button>
            </div>

            <label className="mt-5 flex items-center gap-3 rounded-2xl border border-[#143e2a]/10 bg-white px-4 py-3.5 shadow-[0_8px_28px_rgba(19,53,36,.07)] focus-within:border-[#438158] focus-within:ring-2 focus-within:ring-[#438158]/10">
