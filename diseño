        <p className="mt-2 text-sm text-[#6c7b72]">Completa tus datos para empezar a reservar.</p>
      </div>
      <form className="mt-7 space-y-4" onSubmit={submit}>
        <Field error={errors.name} icon="user" label="Nombre completo" onChange={(value) => update("name", value)} placeholder="Tu nombre y apellido" value={values.name} />
        <Field error={errors.email} icon="mail" label="Correo" onChange={(value) => update("email", value)} placeholder="tu@correo.com" type="email" value={values.email} />
        <Field error={errors.phone} icon="phone" label="Celular de contacto" onChange={(value) => update("phone", value.replace(/\D/g, "").slice(0, 10))} placeholder="300 000 0000" type="tel" value={values.phone} />
        <Field error={errors.password} icon="lock" label="Contraseña" onChange={(value) => update("password", value)} placeholder="Mínimo 8 caracteres" type="password" value={values.password} />

        <button
          aria-pressed={owner}
          className="flex w-full items-center justify-between rounded-2xl border border-[#143e2a]/10 bg-white p-4 text-left"
          onClick={() => setOwner(!owner)}
          type="button"
        >
          <span>
            <span className="block text-sm font-extrabold">Soy dueño de una cancha</span>
            <span className="mt-0.5 block text-xs font-medium text-[#748179]">Administra reservas y pagos</span>
          </span>
          <span className={`relative h-7 w-12 rounded-full transition ${owner ? "bg-[#174e32]" : "bg-[#d9ddd8]"}`}>
            <span className={`absolute top-1 size-5 rounded-full bg-white shadow-sm transition ${owner ? "left-6" : "left-1"}`} />
          </span>
        </button>

        <button className="mt-2 w-full rounded-2xl bg-[#174e32] py-4 text-[15px] font-extrabold text-white shadow-[0_12px_28px_rgba(23,78,50,.2)]" type="submit">
          Crear cuenta
        </button>
        <p className="px-4 text-center text-[11px] leading-relaxed text-[#7d8982]">Al continuar aceptas los términos de uso y la política de privacidad.</p>
      </form>
    </AuthShell>
  );
}

function RecoverScreen({ goTo }: { goTo: (screen: AppScreen) => void }) {
  const [email, setEmail] = useState("");
  const [sent, setSent] = useState(false);

  return (
    <AuthShell onBack={() => goTo("login")}>
      <div className="flex flex-1 flex-col justify-center py-10">
        <span className="grid size-16 place-items-center rounded-[22px] bg-[#e2f0dc] text-[#174e32]"><Icon name="mail" size={27} /></span>
        <h1 className="mt-6 text-3xl font-extrabold tracking-[-0.045em]">{sent ? "Revisa tu correo" : "Recupera tu contraseña"}</h1>
        <p className="mt-3 text-sm leading-relaxed text-[#6c7b72]">
          {sent ? <>Te enviamos un enlace a <strong className="text-[#304c3b]">{email}</strong>. Revisa también la carpeta de spam.</> : "Ingresa el correo de tu cuenta y te enviaremos un enlace para crear una contraseña nueva."}
        </p>
        {!sent ? (
          <div className="mt-8">
            <Field icon="mail" label="Correo" onChange={setEmail} placeholder="tu@correo.com" type="email" value={email} />
            <button className="mt-6 w-full rounded-2xl bg-[#174e32] py-4 text-[15px] font-extrabold text-white" onClick={() => email && setSent(true)}>Enviar enlace</button>
          </div>
        ) : (
          <button className="mt-8 w-full rounded-2xl border border-[#174e32]/15 bg-white py-4 text-sm font-extrabold text-[#174e32]" onClick={() => setSent(false)}>Enviar de nuevo</button>
        )}
        <button className="mt-4 w-full py-3 text-sm font-extrabold text-[#286a42]" onClick={() => goTo("new-password")}>Ya tengo el código</button>
      </div>
    </AuthShell>
  );
}

function NewPasswordScreen({ goTo }: { goTo: (screen: AppScreen) => void }) {
  const [code, setCode] = useState("");
  const [password, setPassword] = useState("");
  const [saved, setSaved] = useState(false);

  return (
    <AuthShell onBack={() => goTo("recover")}>
      <div className="flex flex-1 flex-col justify-center py-10">
        {saved ? (
          <div className="text-center">
            <span className="mx-auto grid size-20 place-items-center rounded-full bg-[#d9ff5b] text-3xl font-black text-[#174e32]">✓</span>
            <h1 className="mt-6 text-3xl font-extrabold tracking-[-0.045em]">Contraseña actualizada</h1>
            <p className="mt-3 text-sm text-[#6c7b72]">Ya puedes ingresar con tu nueva contraseña.</p>
            <button className="mt-8 w-full rounded-2xl bg-[#174e32] py-4 text-sm font-extrabold text-white" onClick={() => goTo("login")}>Volver a ingresar</button>
          </div>
        ) : (
          <>
            <span className="grid size-16 place-items-center rounded-[22px] bg-[#e2f0dc] text-[#174e32]"><Icon name="lock" size={27} /></span>
            <h1 className="mt-6 text-3xl font-extrabold tracking-[-0.045em]">Crea una contraseña nueva</h1>
            <p className="mt-3 text-sm leading-relaxed text-[#6c7b72]">Pega el código que recibiste y elige una contraseña segura.</p>
            <div className="mt-8 space-y-5">
              <Field icon="mail" label="Código del enlace" onChange={setCode} placeholder="Ej. GZ-482910" value={code} />
              <Field icon="lock" label="Contraseña nueva" onChange={setPassword} placeholder="Mínimo 8 caracteres" type="password" value={password} />
              <button className="w-full rounded-2xl bg-[#174e32] py-4 text-sm font-extrabold text-white disabled:opacity-40" disabled={!code || password.length < 8} onClick={() => setSaved(true)}>Guardar contraseña</button>
            </div>
          </>
        )}
      </div>
    </AuthShell>
  );
}

function VerifyEmailScreen({ goTo }: { goTo: (screen: AppScreen) => void }) {
  const expired = new URLSearchParams(window.location.search).get("status") === "expired";

  return (
    <AuthShell>
      <div className="flex flex-1 flex-col items-center justify-center py-10 text-center">
        <div className="relative">
          <span className={`grid size-24 place-items-center rounded-full text-4xl font-black ${expired ? "bg-[#f8dfdc] text-[#b63b32]" : "bg-[#d9ff5b] text-[#174e32]"}`}>{expired ? "!" : "✓"}</span>
          {!expired && <span className="absolute -right-1 top-0 size-5 rounded-full bg-[#174e32]" />}
        </div>
        <p className={`mt-8 text-sm font-bold ${expired ? "text-[#b63b32]" : "text-[#438158]"}`}>{expired ? "No pudimos verificarlo" : "Todo listo"}</p>
        <h1 className="mt-2 text-4xl font-extrabold tracking-[-0.05em]">{expired ? "El enlace venció" : "¡Correo confirmado!"}</h1>
        <p className="mt-3 max-w-xs text-sm leading-relaxed text-[#6c7b72]">
          {expired ? "Este enlace ya no es válido. Ingresa a tu perfil para solicitar uno nuevo." : "Tu correo fue verificado correctamente. Ya puedes usar todas las funciones de Noventa."}
        </p>
        <button className="mt-9 w-full rounded-2xl bg-[#174e32] py-4 text-sm font-extrabold text-white" onClick={() => goTo(expired ? "login" : "courts")}>{expired ? "Volver al inicio" : "Continuar"}</button>
      </div>
    </AuthShell>
  );
}

function SplashScreen({ onDone }: { onDone: () => void }) {
  const [connectionError, setConnectionError] = useState(
    () => new URLSearchParams(window.location.search).get("sessionError") === "1",
  );

  useEffect(() => {
    if (connectionError) return;
    const timer = window.setTimeout(onDone, 1400);
    return () => window.clearTimeout(timer);
  }, [connectionError, onDone]);

  return (
    <main className="flex min-h-screen flex-col items-center justify-center bg-[#07100b] px-8 text-white">
      <div className="flex flex-1 items-center"><Brand light /></div>
      {connectionError ? (
        <div className="mb-[max(40px,env(safe-area-inset-bottom))] w-full max-w-xs rounded-[22px] border border-white/10 bg-white/8 p-5 text-center">
          <p className="text-sm font-extrabold">No pudimos conectar</p>
          <p className="mt-1 text-xs leading-relaxed text-white/55">Revisa tu conexión e inténtalo de nuevo.</p>
          <button className="mt-4 w-full rounded-xl bg-[#d9ff5b] py-3 text-sm font-extrabold text-[#11251b]" onClick={() => setConnectionError(false)}>Reintentar</button>
        </div>
      ) : (
        <div className="mb-[max(40px,env(safe-area-inset-bottom))] flex items-center gap-3 text-xs font-semibold text-white/55">
          <span className="size-5 animate-spin rounded-full border-2 border-white/20 border-t-[#d9ff5b]" />
          Recuperando tu sesión
        </div>
      )}
    </main>
  );
}

function App() {
  const [role, setRole] = useState<AppRole>("player");
  const [selectedCourt, setSelectedCourt] = useState<(typeof courts)[number]>(courts[0]);
  const [bookingDraft, setBookingDraft] = useState<BookingDraft | null>(null);
  const [screen, setScreen] = useState<AppScreen>(() => {
    const entry = `${window.location.pathname}${window.location.hash}`;
    if (entry.includes("reset-password")) return "new-password";
    if (entry.includes("verify-email")) return "verify";
    return "splash";
  });

  if (screen === "splash") return <SplashScreen onDone={() => setScreen("login")} />;
  if (screen === "login") return <LoginScreen goTo={setScreen} />;
  if (screen === "register") return <RegisterScreen goTo={setScreen} />;
  if (screen === "recover") return <RecoverScreen goTo={setScreen} />;
  if (screen === "new-password") return <NewPasswordScreen goTo={setScreen} />;
  if (screen === "verify") return <VerifyEmailScreen goTo={setScreen} />;
  if (screen === "player-reservations") return <PlayerReservations goTo={setScreen} />;
  if (screen === "notifications") return <NotificationsScreen goTo={setScreen} role={role} />;
  if (screen === "profile") {
    return (
      <ProfileScreen
        goTo={setScreen}
        role={role}
        onRole={(nextRole) => {
          setRole(nextRole);
          setScreen(nextRole === "player" ? "courts" : nextRole === "owner" ? "owner-reservations" : "admin-summary");
        }}
      />
    );
  }
  if (screen === "owner-reservations") return <OwnerReservations goTo={setScreen} />;
  if (screen === "owner-payments") return <OwnerPayments goTo={setScreen} />;
  if (screen === "owner-courts") return <OwnerCourts goTo={setScreen} />;
  if (screen === "new-court") return <CourtFormScreen goTo={setScreen} />;
  if (screen === "manage-court") return <ManageCourtScreen goTo={setScreen} />;
  if (screen === "stats") return <StatsScreen goTo={setScreen} />;
  if (screen.startsWith("admin-")) return <AdminScreen goTo={setScreen} screen={screen} />;
  if (screen === "payment" && bookingDraft) {
    return <PaymentScreen booking={bookingDraft} onBack={() => setScreen("detail")} onReservations={() => setScreen("courts")} />;
  }
  if (screen === "detail") {
    return (
      <CourtDetail
        court={selectedCourt}
        onBack={() => setScreen("courts")}
        onContinue={(booking) => {
          setBookingDraft(booking);
          setScreen("payment");
          window.scrollTo({ top: 0 });
        }}
      />
    );
  }
  return (
    <PlayerCourts
      goTo={setScreen}
      onOpenCourt={(court) => {
        setSelectedCourt(court);
        setScreen("detail");
        window.scrollTo({ top: 0 });
      }}
    />
  );
}

export default App;