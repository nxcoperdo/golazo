function Icon({ name, size = 20, filled = false }: { name: IconName; size?: number; filled?: boolean }) {
  const paths: Record<IconName, React.ReactNode> = {
    calendar: <><path d="M6 2v3M14 2v3M3 8h14M5 4h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" /></>,
    chevron: <path d="m7 4 6 6-6 6" />,
    clock: <><circle cx="10" cy="10" r="8" /><path d="M10 6v4l3 2" /></>,
    copy: <><rect x="6" y="6" width="11" height="11" rx="2" /><path d="M14 6V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></>,
    eye: <><path d="M2 10s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" /><circle cx="10" cy="10" r="2.5" /></>,
    heart: <path d="M17.4 4.6a4.2 4.2 0 0 0-5.9 0L10 6.1 8.5 4.6a4.2 4.2 0 0 0-5.9 5.9L10 18l7.4-7.5a4.2 4.2 0 0 0 0-5.9Z" />,
    home: <><path d="m2 9 8-7 8 7" /><path d="M4 8v10h12V8M8 18v-6h4v6" /></>,
    lock: <><rect x="4" y="8" width="12" height="10" rx="2" /><path d="M7 8V6a3 3 0 0 1 6 0v2" /></>,
    location: <><path d="M16 8c0 5-6 10-6 10S4 13 4 8a6 6 0 1 1 12 0Z" /><circle cx="10" cy="8" r="2" /></>,
    mail: <><rect x="2" y="4" width="16" height="12" rx="2" /><path d="m3 6 7 5 7-5" /></>,
    map: <><path d="m2 4 5-2 6 2 5-2v14l-5 2-6-2-5 2Z" /><path d="M7 2v14M13 4v14" /></>,
    phone: <path d="M6 2H4a2 2 0 0 0-2 2c0 7.7 6.3 14 14 14a2 2 0 0 0 2-2v-2l-4-1-1 2c-3.5-1.5-6.5-4.5-8-8l2-1-1-4Z" />,
    search: <><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 5 5" /></>,
    star: <path d="m10 2 2.4 5 5.6.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.6-.8Z" />,
    upload: <><path d="M10 13V3M6 7l4-4 4 4" /><path d="M3 12v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" /></>,
    user: <><circle cx="10" cy="6" r="4" /><path d="M3 18c.8-4 3.1-6 7-6s6.2 2 7 6" /></>,
  };

  return (
    <svg
      aria-hidden="true"
      fill={filled ? "currentColor" : "none"}
      height={size}
      viewBox="0 0 20 20"
      width={size}
      stroke="currentColor"
      strokeLinecap="round"
      strokeLinejoin="round"
      strokeWidth="1.7"
    >
      {paths[name]}
    </svg>
  );
}

