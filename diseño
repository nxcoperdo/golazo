  const [notice, setNotice] = useState("");
  const [advanceDialog, setAdvanceDialog] = useState(false);
  const [reportDialog, setReportDialog] = useState(false);
  const advanceRate = court.deposit / 100;

  const days = useMemo(() => {
    const dayNames = ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"];
    const monthNames = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
    return Array.from({ length: 14 }, (_, index) => {
      const date = new Date();
      date.setDate(date.getDate() + index);
      return {
        day: index === 0 ? "Hoy" : dayNames[date.getDay()],
        date: date.getDate(),
        month: monthNames[date.getMonth()],
      };
    });
  }, []);

  function selectHour(index: number) {
    if (timeSlots[index].occupied) return;
    if (selectedHours.length === 0) {
      setSelectedHours([index]);
      return;
    }
    if (selectedHours.includes(index)) {
      if (index === selectedHours[0]) setSelectedHours(selectedHours.slice(1));
      else if (index === selectedHours[selectedHours.length - 1]) setSelectedHours(selectedHours.slice(0, -1));
      else setSelectedHours([index]);
      return;
    }
    const first = selectedHours[0];
    const last = selectedHours[selectedHours.length - 1];
    const next = index === first - 1 ? [index, ...selectedHours] : index === last + 1 ? [...selectedHours, index] : [index];
    setSelectedHours(next.length <= 4 ? next : [index]);
  }

  const total = selectedHours.length * court.price;
  const advance = Math.round(total * advanceRate);
  const canBook = selectedHours.length > 0 && /^3\d{9}$/.test(phone);

  function reserve() {
    if (!canBook) return;
    if (court.deposit > 0) {
      setAdvanceDialog(true);
      return;
    }
    setNotice("¡Reserva confirmada! Puedes verla en Mis reservas.");
    window.setTimeout(() => setNotice(""), 3500);
  }

  return (
    <div className="min-h-screen bg-[#f4f5ec] pb-44 text-[#11251b]">
      <header className="fixed inset-x-0 top-0 z-40 mx-auto flex max-w-md items-center justify-between px-5 pt-[max(16px,env(safe-area-inset-top))]">
        <button aria-label="Volver a canchas" className="grid size-11 place-items-center rounded-full bg-white/95 text-[#174e32] shadow-lg backdrop-blur" onClick={onBack}>
          <span className="rotate-180"><Icon name="chevron" /></span>
        </button>
        <button
          aria-label={favorite ? "Quitar de favoritos" : "Agregar a favoritos"}
          className={`grid size-11 place-items-center rounded-full shadow-lg backdrop-blur ${favorite ? "bg-[#d9ff5b] text-[#174e32]" : "bg-white/95 text-[#174e32]"}`}
          onClick={() => setFavorite(!favorite)}
        >
          <Icon name="heart" filled={favorite} />
        </button>
      </header>

      <main className="mx-auto max-w-md bg-[#f4f5ec]">
        <section className="no-scrollbar flex snap-x snap-mandatory overflow-x-auto">
          {galleryImages.map((image, index) => (
            <div className="relative h-80 w-full shrink-0 snap-center" key={image}>
              <img alt={`${court.name}, fotografía ${index + 1}`} className="h-full w-full object-cover" src={index === 0 ? court.image : image} />
              <div className="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#071b10]/55 to-transparent" />
              <span className="absolute bottom-5 right-5 rounded-full bg-[#071b10]/70 px-3 py-1.5 text-xs font-bold text-white backdrop-blur">
                {index + 1} / {galleryImages.length}
              </span>
            </div>
          ))}
        </section>

        <div className="space-y-3 px-5 pb-5 pt-6">
          <div className="flex items-start justify-between gap-4">
            <div>
              <div className="mb-2 flex flex-wrap gap-2">
                {court.covered && <span className="rounded-full bg-[#d9ff5b] px-3 py-1 text-[11px] font-extrabold text-[#174e32]">Techada</span>}
                {court.deposit > 0 && <span className="rounded-full bg-[#e1eee1] px-3 py-1 text-[11px] font-extrabold text-[#285e3c]">Anticipo {court.deposit} %</span>}
              </div>
              <h1 className="text-3xl font-extrabold leading-tight tracking-[-0.05em]">{court.name}</h1>
            </div>
            <span className="mt-8 flex shrink-0 items-center gap-1 text-sm font-extrabold">
              <span className="text-[#f3b61f]"><Icon name="star" size={17} filled /></span>
              {court.rating}
            </span>
          </div>
          <button className="flex items-center gap-1 text-sm font-semibold text-[#52665a]">
            <span className="font-extrabold text-[#174e32]">{court.reviews} reseñas</span>
            <Icon name="chevron" size={14} />
          </button>
          <p className="flex items-start gap-2 text-sm leading-relaxed text-[#5c6d63]">
            <span className="mt-0.5 text-[#438158]"><Icon name="location" size={17} /></span>
            Carrera 13 # 58-24, {court.area} · {court.city}
          </p>
        </div>

        <div className="mx-5 h-px bg-[#143e2a]/10" />

        <section className="px-5 py-6">
          <h2 className="text-lg font-extrabold tracking-[-0.025em]">Sobre la cancha</h2>
          <p className="mt-3 text-sm leading-6 text-[#65736b]">Cancha sintética en excelente estado, iluminada y techada. Incluye camerinos, parqueadero para bicicletas y zona de hidratación.</p>
          <div className="mt-4 grid grid-cols-2 gap-3">
            <div className="rounded-2xl bg-white p-4">
              <span className="text-[#438158]"><Icon name="clock" size={20} /></span>
              <p className="mt-3 text-xs font-semibold text-[#78877e]">Horario</p>
              <p className="mt-1 text-sm font-extrabold">8 a. m. – 10 p. m.</p>
            </div>
            <div className="rounded-2xl bg-white p-4">
              <span className="text-[#438158]"><Icon name="calendar" size={20} /></span>
              <p className="mt-3 text-xs font-semibold text-[#78877e]">Tipo</p>
              <p className="mt-1 text-sm font-extrabold">{court.type} · {court.covered ? "Techada" : "Al aire libre"}</p>
            </div>
          </div>
        </section>

        <section className="border-y border-[#143e2a]/10 bg-white py-6">
          <div className="px-5">
            <p className="text-xs font-bold uppercase tracking-[0.12em] text-[#438158]">Paso 1</p>
            <h2 className="mt-1 text-xl font-extrabold tracking-[-0.03em]">Elige el día</h2>
          </div>
          <div className="no-scrollbar mt-4 flex gap-2 overflow-x-auto px-5">
            {days.map((day, index) => (
              <button
                className={`flex min-w-16 shrink-0 flex-col items-center rounded-2xl border px-3 py-3 transition ${
                  dayIndex === index ? "border-[#174e32] bg-[#174e32] text-white shadow-lg" : "border-[#143e2a]/10 bg-[#f7f8f2] text-[#5f7066]"
                }`}
                key={`${day.date}-${day.month}`}
                onClick={() => {
                  setDayIndex(index);
                  setSelectedHours([]);
                }}
              >
                <span className="text-[11px] font-bold capitalize">{day.day}</span>
                <span className="mt-1 text-xl font-extrabold">{day.date}</span>
                <span className="text-[10px] font-semibold uppercase">{day.month}</span>
              </button>
            ))}
          </div>

          <div className="mt-8 px-5">
            <div className="flex items-end justify-between">
              <div>
                <p className="text-xs font-bold uppercase tracking-[0.12em] text-[#438158]">Paso 2</p>
                <h2 className="mt-1 text-xl font-extrabold tracking-[-0.03em]">Elige la hora</h2>
              </div>
              <span className="text-xs font-semibold text-[#78877e]">Máx. 4 horas</span>
            </div>
            <div className="mt-4 grid grid-cols-3 gap-2">
              {timeSlots.map((slot, index) => {
                const selected = selectedHours.includes(index);
                return (
                  <button
                    className={`rounded-xl border py-3 text-xs font-extrabold transition ${
                      slot.occupied
                        ? "cursor-not-allowed border-transparent bg-[#eef0eb] text-[#a6aea9] line-through"
                        : selected
                          ? "border-[#174e32] bg-[#d9ff5b] text-[#11251b]"
                          : "border-[#143e2a]/12 bg-white text-[#304c3b]"
                    }`}
                    disabled={slot.occupied}
                    key={slot.label}
                    onClick={() => selectHour(index)}
                  >
                    {slot.label}
                  </button>
                );
              })}
            </div>
            <div className="mt-3 flex gap-4 text-[11px] font-semibold text-[#77837c]">
              <span className="flex items-center gap-1.5"><span className="size-2.5 rounded-full bg-white ring-1 ring-[#174e32]/20" />Libre</span>
              <span className="flex items-center gap-1.5"><span className="size-2.5 rounded-full bg-[#d9ff5b] ring-1 ring-[#174e32]" />Elegida</span>
              <span className="flex items-center gap-1.5"><span className="size-2.5 rounded-full bg-[#dfe3dd]" />Ocupada</span>
            </div>
          </div>
        </section>

        <section className="px-5 py-6">
          <h2 className="text-lg font-extrabold tracking-[-0.025em]">Tu celular de contacto</h2>
          <p className="mt-1 text-xs leading-relaxed text-[#78877e]">El dueño lo usará únicamente si necesita contactarte por esta reserva.</p>
          <div className="mt-4">
            <Field
              error={phone.length > 0 && !/^3\d{9}$/.test(phone) ? "Debe tener 10 dígitos y empezar por 3." : undefined}
              icon="phone"
              label="Celular"
              onChange={(value) => setPhone(value.replace(/\D/g, "").slice(0, 10))}
              placeholder="300 000 0000"
              type="tel"
              value={phone}
            />
          </div>
        </section>

        <section className="border-t border-[#143e2a]/10 bg-white px-5 py-6">
          <div className="flex items-end justify-between">
            <div>
              <p className="text-xs font-bold uppercase tracking-[0.12em] text-[#438158]">Comunidad</p>
              <h2 className="mt-1 text-xl font-extrabold tracking-[-0.03em]">Reseñas</h2>
            </div>
            <button className="text-xs font-extrabold text-[#286a42]">Ver todas</button>
          </div>
          {[
            { author: "Laura M.", rating: 5, text: "La cancha está impecable y la atención fue muy buena. Volveremos.", date: "Hace 3 días" },
            { author: "Andrés P.", rating: 4, text: "Buena iluminación y fácil acceso. El parqueadero es pequeño.", date: "Hace 2 semanas" },
          ].map((review) => (
            <article className="border-b border-[#143e2a]/8 py-5 last:border-0" key={review.author}>
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-3">
                  <span className="grid size-9 place-items-center rounded-full bg-[#e4eee0] text-xs font-extrabold text-[#174e32]">{review.author.charAt(0)}</span>
                  <div>
                    <p className="text-sm font-extrabold">{review.author}</p>
                    <div className="mt-0.5 flex text-[#f3b61f]">{Array.from({ length: review.rating }, (_, index) => <Icon key={index} name="star" size={12} filled />)}</div>
                  </div>
                </div>
                <span className="text-[11px] font-semibold text-[#8a968f]">{review.date}</span>
              </div>
              <p className="mt-3 text-sm leading-relaxed text-[#5f7066]">{review.text}</p>
              <button className="mt-2 text-[11px] font-bold text-[#8a968f]" onClick={() => setReportDialog(true)}>Reportar</button>
            </article>
          ))}
        </section>
      </main>

      <div className="fixed inset-x-0 bottom-0 z-40 border-t border-[#143e2a]/10 bg-white/96 px-5 pb-[max(16px,env(safe-area-inset-bottom))] pt-4 backdrop-blur-xl">
        <div className="mx-auto max-w-md">
          <div className="mb-3 flex items-end justify-between">
            <div>
              <p className="text-xs font-semibold text-[#78877e]">{selectedHours.length ? `${selectedHours.length} h${court.deposit ? ` · Anticipo $${advance.toLocaleString("es-CO")}` : ""}` : "Selecciona una hora"}</p>
              <p className="mt-0.5 text-2xl font-extrabold tracking-[-0.04em]">${total.toLocaleString("es-CO")} <span className="text-xs font-semibold text-[#78877e]">total</span></p>
            </div>
            <p className="text-xs font-bold text-[#438158]">${court.price.toLocaleString("es-CO")}/h</p>
          </div>
          <button className="w-full rounded-2xl bg-[#174e32] py-4 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(23,78,50,.2)] disabled:cursor-not-allowed disabled:opacity-35" disabled={!canBook} onClick={reserve}>Reservar</button>
        </div>
      </div>

      {notice && (
        <div className="fixed left-1/2 top-24 z-50 w-[calc(100%-2.5rem)] max-w-sm -translate-x-1/2 rounded-2xl bg-[#11251b] px-5 py-4 text-center text-sm font-bold text-white shadow-2xl">
          {notice}
        </div>
      )}

      {advanceDialog && (
        <div className="fixed inset-0 z-50 flex items-end justify-center bg-[#071b10]/55 px-0 backdrop-blur-[2px] sm:items-center sm:px-5">
          <div className="w-full max-w-sm rounded-t-[28px] bg-white px-5 pb-[max(24px,env(safe-area-inset-bottom))] pt-3 shadow-2xl sm:rounded-[28px] sm:pb-6">
            <div className="mx-auto h-1 w-10 rounded-full bg-[#d5dbd6] sm:hidden" />
            <span className="mt-5 grid size-14 place-items-center rounded-2xl bg-[#fff2cd] text-2xl sm:mt-0">!</span>
            <h2 className="mt-5 text-2xl font-extrabold leading-tight tracking-[-0.04em]">Esta reserva requiere anticipo</h2>
            <p className="mt-3 text-sm leading-relaxed text-[#66756c]">
              Para asegurar el horario debes transferir <strong className="text-[#11251b]">${advance.toLocaleString("es-CO")}</strong>, equivalente al {court.deposit} % del total.
            </p>
            <div className="mt-5 rounded-2xl bg-[#f2f5ee] p-4">
              <div className="flex justify-between text-sm"><span className="text-[#6c7b72]">Reserva</span><strong>{selectedHours.length} h</strong></div>
              <div className="mt-2 flex justify-between text-sm"><span className="text-[#6c7b72]">Total</span><strong>${total.toLocaleString("es-CO")}</strong></div>
            </div>
            <p className="mt-4 text-xs leading-relaxed text-[#7d8982]">Tendrás 30 minutos para subir el comprobante o las horas se liberarán automáticamente.</p>
            <button
              className="mt-6 w-full rounded-2xl bg-[#174e32] py-4 text-sm font-extrabold text-white"
              onClick={() => onContinue({
                court,
                dateLabel: `${days[dayIndex].day} ${days[dayIndex].date} ${days[dayIndex].month}`,
                hours: selectedHours.length,
                timeLabel: `${timeSlots[selectedHours[0]].label} – ${timeSlots[selectedHours[selectedHours.length - 1] + 1]?.label ?? "10:00 p. m."}`,
                total,
                advance,
              })}
            >
              Pagar anticipo
            </button>
            <button className="mt-2 w-full py-3 text-sm font-extrabold text-[#65736b]" onClick={() => setAdvanceDialog(false)}>Cancelar</button>
          </div>
        </div>
      )}
      {reportDialog && (
        <div className="fixed inset-0 z-50 flex items-end bg-[#071b10]/50">
          <div className="w-full rounded-t-[28px] bg-white p-5 pb-[max(24px,env(safe-area-inset-bottom))]">
            <div className="mx-auto h-1 w-10 rounded-full bg-[#d5dbd6]" />
            <h2 className="mt-5 text-2xl font-extrabold">Reportar reseña</h2>
            <p className="mt-2 text-sm text-[#66756c]">Cuéntanos por qué esta reseña debería revisarse.</p>
            <div className="mt-5 space-y-2">{["Lenguaje ofensivo", "Información falsa", "Contenido no relacionado", "Otro motivo"].map((reason) => <button className="w-full rounded-xl border border-[#143e2a]/10 px-4 py-3 text-left text-sm font-bold" key={reason} onClick={() => setReportDialog(false)}>{reason}</button>)}</div>
            <button className="mt-3 w-full py-3 text-sm font-bold text-[#65736b]" onClick={() => setReportDialog(false)}>Cancelar</button>
          </div>
        </div>
      )}
    </div>
  );
}

function PaymentScreen({
  booking,
  onBack,
  onReservations,
}: {
  booking: BookingDraft;
  onBack: () => void;
  onReservations: () => void;
}) {
  const [proof, setProof] = useState("");
  const [status, setStatus] = useState<"pending" | "review">("pending");
  const [copied, setCopied] = useState(false);
  const accountNumber = "300 456 7890";

  function copyAccount() {
    navigator.clipboard?.writeText(accountNumber);
    setCopied(true);
    window.setTimeout(() => setCopied(false), 2200);
  }

  if (status === "review") {
    return (
      <main className="min-h-screen bg-[#f4f5ec] px-5 pb-8 pt-[max(24px,env(safe-area-inset-top))] text-[#11251b]">
