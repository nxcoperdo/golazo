                      )}
                    </div>
                    <span className="flex items-center gap-1 text-sm font-extrabold">
                      <span className="text-[#f3b61f]"><Icon name="star" size={16} filled /></span>
                      {court.rating}
                      <span className="font-medium text-[#8b978f]">({court.reviews})</span>
                    </span>
                  </div>

                  <div className="my-5 flex items-center gap-2 rounded-xl bg-[#edf3e9] px-3 py-2.5 text-sm font-bold text-[#285e3c]">
                    <Icon name="clock" size={17} />
